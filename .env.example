# Copy to .env and fill in at least one key. Without any key the app runs retrieval only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# LLM_PROVIDER=auto              # auto | openai | anthropic (auto: OpenAI if its key is set)
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# ANTHROPIC_MODEL=claude-opus-5-5
# PLANNER_MODEL=                 # model for the query planner; defaults to the chat model
# EMBEDDING_PROVIDER=auto        # auto | openai | local (auto: OpenAI if its key is set)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# TOP_K=5
# TIMEZONE=Europe/Rome
# DATA_DIR=data
# INDEX_DIR=.chroma
